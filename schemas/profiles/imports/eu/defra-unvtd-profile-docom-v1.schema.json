{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defra-unvtd-profile-docom-v1.schema.json",
  "title": "Defra UNVTD DOCOM profile",
  "description": "Intra-Union commercial document (DOCOM) certificate, as issued by TRACES for movements of animals and products not requiring an INTRA certificate. Part III follow-up records (redispatch and control outcomes) are a separate aggregate — see defra-unvtd-profile-docom-followup-v1.schema.json.",
  "allOf": [
    {
      "$ref": "../../../core/defra-unvtd-canonical-core-v1.schema.json#/$defs/CertificatePayload"
    },
    {
      "type": "object",
      "properties": {
        "$model": {
          "const": "defra/certificate-internal/1"
        },
        "$type": {
          "const": "docom"
        },
        "exchangedDocument": {
          "allOf": [
            { "$ref": "../../../core/defra-unvtd-canonical-core-v1.schema.json#/$defs/ExchangedDocument" },
            {
              "type": "object",
              "properties": {
                "documentTypeCode": {
                  "const": "332",
                  "description": "UNTDID 1001 code 332 — commercial document. TRACES issues DOCOM under this code."
                }
              }
            }
          ]
        },
        "specifiedConsignment": {
          "$ref": "../../../core/defra-unvtd-canonical-core-v1.schema.json#/$defs/Consignment"
        }
      },
      "required": [
        "$model",
        "$type",
        "exchangedDocument",
        "specifiedConsignment"
      ]
    }
  ]
}