{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docom-event-certificate-updated-v1.schema.json",
  "title": "DOCOM CertificateUpdated event (v1)",
  "description": "Event emitted when a TRACES DOCOM certificate snapshot is observed or republished. Certificate aggregate; subType is DOCOM. data is the full DOCOM profile.",

  "allOf": [
    { "$ref": "profiles/imports/messaging/event-envelope-v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "aggregateType": { "const": "Certificate" },
        "subType": { "const": "DOCOM" },
        "eventType": {
          "const": "uk.gov.defra.trade.imports.traces.CertificateUpdated"
        },
        "data": {
          "$ref": "defra-unvtd-profile-docom-v1.schema.json"
        }
      }
    }
  ]
}
