{
  "@context": {
    "defraUnvtdProfile": "https://defra.gov.uk/trade/unvtd/profile#",
    "unece": "https://vocabulary.uncefact.org/",
    "uncefact": "https://vocabulary.uncefact.org/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "http://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "defraUnvtdProfile:exchangedDocument",
      "@type": "rdf:Property",
      "rdfs:label": "exchangedDocument",
      "rdfs:comment": "The document container at the root of a Defra UNVTD certificate payload. Holds the document identifier, the issuer, signatory authentications, included clauses (reason for import, animals certified for, sub-purpose when applicable), and the accompanying reference documents.",
      "schema:rangeIncludes": { "@id": "uncefact:ExchangedDocument" }
    },
    {
      "@id": "defraUnvtdProfile:isOrHasUnweanedAnimals",
      "@type": "rdf:Property",
      "rdfs:label": "isOrHasUnweanedAnimals",
      "rdfs:comment": "True when the consignment contains any unweaned (non-ablacted) animals. UK welfare indicator on live-animal import pre-notifications.",
      "schema:domainIncludes": { "@id": "uncefact:Consignment" },
      "schema:rangeIncludes": { "@id": "xsd:boolean" }
    },
    {
      "@id": "defraUnvtdProfile:notificationStatusCode",
      "@type": "rdf:Property",
      "rdfs:label": "notificationStatusCode",
      "rdfs:comment": "Defra-internal workflow status of this notification.",
      "schema:domainIncludes": { "@id": "uncefact:ExchangedDocument" },
      "schema:rangeIncludes": { "@id": "https://refdata.tbc.defra.gov.uk/gbn-ag-notification-status" }
    },
    {
      "@id": "defraUnvtdProfile:permanentLocation",
      "@type": "rdf:Property",
      "rdfs:label": "permanentLocation",
      "rdfs:comment": "The permanent address where this individual animal will reside after import, carried as a party with its name, postal address, and contact details (telephone and email). Used for commodities where an animal moves on from the consignment's immediate delivery point to a final home (such as a pet going on to its owner's address). Per-animal placement so different animals on one trade line can carry different addresses.",
      "schema:domainIncludes": { "@id": "uncefact:ProductInstance" },
      "schema:rangeIncludes": { "@id": "uncefact:TradeParty" }
    },
    {
      "@id": "uncefact:individualProductInstance",
      "@type": "rdf:Property",
      "rdfs:label": "individualTradeProductInstance",
      "rdfs:comment": "Per-animal records on a trade line: one entry per individual animal, each carrying its regulatory identifiers and, for pets, its permanent onward address. The Defra UNVTD profiles attach this association to the trade line item rather than to a trade product, because they carry no trade-product level - classification and species sit on the line. Declaring the trade line as a domain keeps the linked-data meaning consistent with that placement; schema:domainIncludes is additive, so the UN/CEFACT default domain (uncefact:Product) is unchanged and still applies wherever a trade-product level is present.",
      "schema:domainIncludes": { "@id": "uncefact:TradeLineItem" },
      "schema:rangeIncludes": { "@id": "uncefact:ProductInstance" }
    },
    {
      "@id": "defraUnvtdProfile:specifiedConsignment",
      "@type": "rdf:Property",
      "rdfs:label": "specifiedConsignment",
      "rdfs:comment": "The consignment carried by a Defra UNVTD certificate payload.",
      "schema:rangeIncludes": { "@id": "uncefact:Consignment" }
    },
    {
      "@id": "defraUnvtdProfile:certificateIdentifier",
      "@type": "rdf:Property",
      "rdfs:label": "certificateIdentifier",
      "rdfs:comment": "The identifier of the certificate a follow-up payload belongs to. Follow-up records are a separate aggregate from the certificate, so they carry the certificate's document identifier rather than the document itself.",
      "schema:rangeIncludes": { "@id": "xsd:string" }
    },
    {
      "@id": "defraUnvtdProfile:followUp",
      "@type": "rdf:Property",
      "rdfs:label": "followUp",
      "rdfs:comment": "The Part III follow-up records held against a certificate: the redispatch details and control outcomes recorded after the certificate was issued. TRACES appends records over the certificate's life without reissuing it.",
      "schema:rangeIncludes": { "@id": "defraUnvtdProfile:FollowUpRecord" }
    },
    {
      "@id": "defraUnvtdProfile:redispatchDetails",
      "@type": "rdf:Property",
      "rdfs:label": "redispatchDetails",
      "rdfs:comment": "Where a consignment was sent after a follow-up control redispatched it, covering the exit authority, the destination country, the transport used, and the operator at the destination.",
      "schema:domainIncludes": { "@id": "defraUnvtdProfile:FollowUpRecord" },
      "schema:rangeIncludes": { "@id": "defraUnvtdProfile:RedispatchDetails" }
    },
    {
      "@id": "defraUnvtdProfile:redispatchDateTime",
      "@type": "rdf:Property",
      "rdfs:label": "redispatchDateTime",
      "rdfs:comment": "When the consignment was redispatched.",
      "schema:domainIncludes": { "@id": "defraUnvtdProfile:RedispatchDetails" },
      "schema:rangeIncludes": { "@id": "xsd:dateTime" }
    },
    {
      "@id": "defraUnvtdProfile:exitAuthorityParty",
      "@type": "rdf:Property",
      "rdfs:label": "exitAuthorityParty",
      "rdfs:comment": "The authority at the point of exit that handled a redispatch, typically a border control post.",
      "schema:domainIncludes": { "@id": "defraUnvtdProfile:RedispatchDetails" },
      "schema:rangeIncludes": { "@id": "uncefact:TradeParty" }
    },
    {
      "@id": "defraUnvtdProfile:placeOfDestinationParty",
      "@type": "rdf:Property",
      "rdfs:label": "placeOfDestinationParty",
      "rdfs:comment": "The operator at the destination a consignment was redispatched to.",
      "schema:domainIncludes": { "@id": "defraUnvtdProfile:RedispatchDetails" },
      "schema:rangeIncludes": { "@id": "uncefact:TradeParty" }
    },
    {
      "@id": "defraUnvtdProfile:meansOfTransport",
      "@type": "rdf:Property",
      "rdfs:label": "meansOfTransport",
      "rdfs:comment": "The transport used for a redispatch, one entry per leg, pairing the transport movement with the international transport document covering it.",
      "schema:domainIncludes": { "@id": "defraUnvtdProfile:RedispatchDetails" },
      "schema:rangeIncludes": { "@id": "defraUnvtdProfile:MeansOfTransport" }
    },
    {
      "@id": "defraUnvtdProfile:internationalTransportDocument",
      "@type": "rdf:Property",
      "rdfs:label": "internationalTransportDocument",
      "rdfs:comment": "Reference of the international transport document covering a leg of a redispatch journey.",
      "schema:domainIncludes": { "@id": "defraUnvtdProfile:MeansOfTransport" },
      "schema:rangeIncludes": { "@id": "xsd:string" }
    },
    {
      "@id": "defraUnvtdProfile:controlDetails",
      "@type": "rdf:Property",
      "rdfs:label": "controlDetails",
      "rdfs:comment": "The outcome of a follow-up control: whether the consignment arrived, whether it was compliant, and the coded control detail behind that finding.",
      "schema:domainIncludes": { "@id": "defraUnvtdProfile:FollowUpRecord" },
      "schema:rangeIncludes": { "@id": "defraUnvtdProfile:ControlDetails" }
    },
    {
      "@id": "defraUnvtdProfile:consignmentArrivedIndicator",
      "@type": "rdf:Property",
      "rdfs:label": "consignmentArrivedIndicator",
      "rdfs:comment": "True when the consignment arrived at its declared destination.",
      "schema:domainIncludes": { "@id": "defraUnvtdProfile:ControlDetails" },
      "schema:rangeIncludes": { "@id": "xsd:boolean" }
    },
    {
      "@id": "defraUnvtdProfile:consignmentCompliantIndicator",
      "@type": "rdf:Property",
      "rdfs:label": "consignmentCompliantIndicator",
      "rdfs:comment": "True when the consignment was found compliant at the follow-up control. When false, the reasons are carried as included notes with subject code REASON_OF_NON_COMPLIANCE.",
      "schema:domainIncludes": { "@id": "defraUnvtdProfile:ControlDetails" },
      "schema:rangeIncludes": { "@id": "xsd:boolean" }
    },
    {
      "@id": "defraUnvtdProfile:certifyingOfficerAuthentication",
      "@type": "rdf:Property",
      "rdfs:label": "certifyingOfficerAuthentication",
      "rdfs:comment": "The officer who signed off a follow-up action, carried as a document authentication in the same shape as the certificate signatories.",
      "schema:domainIncludes": { "@id": "defraUnvtdProfile:FollowUpRecord" },
      "schema:rangeIncludes": { "@id": "uncefact:DocumentAuthentication" }
    }
  ]
}
